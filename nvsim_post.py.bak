#!/usr/bin/env python3
import argparse, math, os, re, sys, tempfile, shutil, glob, subprocess, time

# ---------------------- helpers: cfg parsing & csv tail parse ----------------------

def parse_cfg(path):
    out = {
        "process_nm": None, "temp_K": None, "device": None,
        "word_width_bits": None, "design": None,
        "capacity_B": None, "memcell_file": None,
        "output_prefix": "output",
        "internal_sensing": None,
    }
    if not path: return out
    with open(path, 'r', encoding='utf-8') as f:
        for raw in f:
            line = raw.strip()
            m = re.match(r'^-ProcessNode:\s*(\d+)', line)
            if m: out["process_nm"] = int(m.group(1)); continue
            m = re.match(r'^-Temperature \(K\):\s*(\d+)', line)
            if m: out["temp_K"] = int(m.group(1)); continue
            m = re.match(r'^-DeviceRoadmap:\s*(HP|LSTP|LOP)', line)
            if m: out["device"] = m.group(1); continue
            m = re.match(r'^-WordWidth \(bit\):\s*(\d+)', line)
            if m: out["word_width_bits"] = int(m.group(1)); continue
            m = re.match(r'^-DesignTarget:\s*(\S+)', line)
            if m: out["design"] = m.group(1); continue
            m = re.match(r'^-MemoryCellInputFile:\s*(\S+)', line)
            if m: out["memcell_file"] = os.path.basename(m.group(1)); continue
            m = re.match(r'^-OutputFilePrefix:\s*(\S+)', line)
            if m: out["output_prefix"] = m.group(1); continue
            m = re.match(r'^-InternalSensing:\s*(true|false)', line, re.I)
            if m: out["internal_sensing"] = (m.group(1).lower() == "true"); continue
            # Capacity (B|KB|MB)
            m = re.match(r'^-Capacity \(B\):\s*(\d+)', line)
            if m: out["capacity_B"] = int(m.group(1)); continue
            m = re.match(r'^-Capacity \(KB\):\s*(\d+)', line)
            if m: out["capacity_B"] = int(m.group(1)) * 1024; continue
            m = re.match(r'^-Capacity \(MB\):\s*(\d+)', line)
            if m: out["capacity_B"] = int(m.group(1)) * 1024 * 1024; continue
    return out

def to_float(x):
    try:
        return float(x)
    except Exception:
        return math.nan

def parse_nvsim_row(line, expect_trailing_trc=True):
    # NVSim CSV has no header; we index from the tail (compatible with your patched Result.cpp).
    toks = [t.strip() for t in line.strip().split(',')]
    while toks and toks[-1] == '':
        toks.pop()
    if not toks:
        return None
    # Tail layout with tRC injected (non-cache):
    # [..., bank.height_um, bank.width_um, bank.area_mm2,
    #      mat.height_um, mat.width_um, mat.area_mm2,
    #      sub.height_um, sub.width_um, sub.area_mm2,
    #      area_eff_percent,
    #      read_lat_ns, write_lat_ns, read_E_pJ, write_E_pJ, leakage_mW, tRC_ns]
    if expect_trailing_trc and len(toks) >= 16:
        area_mm2     = to_float(toks[-14])
        read_lat_ns  = to_float(toks[-6])
        write_lat_ns = to_float(toks[-5])
        read_E_pJ    = to_float(toks[-4])
        write_E_pJ   = to_float(toks[-3])
        leakage_mW   = to_float(toks[-2])
        tRC_ns       = to_float(toks[-1])
    else:
        # fallback (no tRC column at tail)
        if len(toks) < 15:
            return None
        area_mm2     = to_float(toks[-13])
        read_lat_ns  = to_float(toks[-5])
        write_lat_ns = to_float(toks[-4])
        read_E_pJ    = to_float(toks[-3])
        write_E_pJ   = to_float(toks[-2])
        leakage_mW   = to_float(toks[-1])
        tRC_ns       = math.nan
    return {
        "area_mm2": area_mm2,
        "read_lat_ns": read_lat_ns,
        "write_lat_ns": write_lat_ns,
        "read_E_pJ": read_E_pJ,
        "write_E_pJ": write_E_pJ,
        "leakage_mW": leakage_mW,
        "tRC_ns": tRC_ns,
    }

# ---------------------- NVSim runners ----------------------

_csv_generated_re = re.compile(r'([^\s]+\.csv)\s+generated successfully!?', re.I)

def run_nvsim_and_get_csv(nvsim_bin, cfg_path, prefix_hint=None):
    """
    Run NVSim once and return the absolute path to the CSV it produced.
    Robust to NVSim writing into the cfg's directory and to missing banner lines.
    """
    workdir = os.path.abspath(os.path.dirname(cfg_path) or ".")
    pat = f"{prefix_hint or ''}*.csv"

    # Snapshot BEFORE run (in the cfg directory)
    before = set(glob.glob(os.path.join(workdir, pat)))

    # Run NVSim IN the cfg directory so outputs land there
    proc = subprocess.run([nvsim_bin, os.path.basename(cfg_path)],
                          cwd=workdir,
                          stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT,
                          text=True)
    out = proc.stdout or ""
    if proc.returncode != 0:
        # Surface NVSim output to help debug
        print(out, file=sys.stderr)
        return None

    # 1) Prefer the banner line if present
    m = _csv_generated_re.search(out)
    if m:
        p = m.group(1)
        if not os.path.isabs(p):
            p = os.path.join(workdir, p)
        return os.path.abspath(p) if os.path.exists(p) else None

    # 2) Otherwise detect newly created/updated files with our prefix
    after = set(glob.glob(os.path.join(workdir, pat)))
    newly = list(after - before)
    if newly:
        newly.sort(key=lambda x: os.path.getmtime(x))
        return os.path.abspath(newly[-1])

    # 3) Last resort: newest matching file in cfg dir
    cands = sorted(glob.glob(os.path.join(workdir, pat)), key=lambda p: os.path.getmtime(p))
    return os.path.abspath(cands[-1]) if cands else None

def rewrite_cfg_for_capacity(orig_cfg_path, dst_cfg_path, cap_MB, out_prefix, opt_target="Area"):
    """Write a copy of cfg with new capacity and a fixed OutputFilePrefix."""
    with open(orig_cfg_path, 'r', encoding='utf-8') as f:
        lines = f.readlines()
    # strip capacities
    lines = [ln for ln in lines if not re.match(r'^-Capacity \((B|KB|MB)\):', ln)]
    lines.append(f"-Capacity (MB): {int(round(cap_MB))}\n")
    # friendlier sweep defaults (faster/robust)
    def repl(key, val):
        found = False
        for i,ln in enumerate(lines):
            if re.match(rf'^{re.escape(key)}\s*:', ln):
                lines[i] = f"{key}: {val}\n"; found = True
        if not found:
            lines.append(f"{key}: {val}\n")
    repl("-OptimizationTarget", opt_target)   # Area
    repl("-EnablePruning", "Yes")
    repl("-UseCactiAssumption", "Yes")
    repl("-OutputFilePrefix", out_prefix)
    with open(dst_cfg_path, 'w', encoding='utf-8') as f:
        f.writelines(lines)

def newest_csv_with_prefix(prefix):
    cand = sorted(glob.glob(f"{prefix}_*.csv"), key=lambda p: os.path.getmtime(p), reverse=True)
    return cand[0] if cand else None

def parse_csv_min_area(csv_path):
    """Return min area_mm2 from a CSV (robust to tRC present/absent)."""
    mins = math.inf
    try:
        with open(csv_path, 'r', encoding='utf-8') as f:
            for line in f:
                r = parse_nvsim_row(line, expect_trailing_trc=True)
                if not r:
                    r = parse_nvsim_row(line, expect_trailing_trc=False)
                if not r:
                    continue
                if not math.isnan(r["area_mm2"]):
                    mins = min(mins, r["area_mm2"])
    except FileNotFoundError:
        return math.nan
    return mins if mins != math.inf else math.nan

def sweep_and_fit_area(nvsim_bin, base_cfg_path, min_MB, max_MB, step_MB, keep_csv=False):
    """Run NVSim at capacities in [min,max] step, fit area vs MB: area ≈ a + b*MB. Returns (slope=b, area_at_cfg_MB)."""
    if not os.path.isfile(nvsim_bin) or not os.access(nvsim_bin, os.X_OK):
        print("[nvsim_post] NVSim binary not found or not executable; skipping sweep.", file=sys.stderr)
        return (math.nan, math.nan)
    if not base_cfg_path or not os.path.isfile(base_cfg_path):
        print("[nvsim_post] --cfg is required for sweep; skipping.", file=sys.stderr)
        return (math.nan, math.nan)

    work = tempfile.mkdtemp(prefix="nvsim_sweep_")
    prefix = f"sweep_{int(time.time())}"
    xs, ys = [], []
    try:
        x = float(min_MB); stop = float(max_MB); step = float(step_MB)
        while x <= stop + 1e-9:
            MB_int = int(round(x))
            cfg_i = os.path.join(work, f"cfg_{MB_int}MB.cfg")
            rewrite_cfg_for_capacity(base_cfg_path, cfg_i, MB_int, prefix, opt_target="Area")
            csv_path = run_nvsim_and_get_csv(nvsim_bin, cfg_i, prefix_hint=prefix)
            if not csv_path:
                print(f"[nvsim_post] no CSV produced for {MB_int} MB", file=sys.stderr)
            else:
                a = parse_csv_min_area(csv_path)
                if not math.isnan(a):
                    xs.append(float(MB_int)); ys.append(a)
                if not keep_csv:
                    try: os.remove(csv_path)
                    except Exception: pass
            x += step

        if len(xs) < 2:
            return (math.nan, math.nan)

        # linear fit y = a + b*x
        n = float(len(xs))
        sx = sum(xs); sy = sum(ys)
        sxx = sum(x*x for x in xs); sxy = sum(x*y for x,y in zip(xs, ys))
        denom = (n*sxx - sx*sx)
        if abs(denom) < 1e-18:
            m = math.nan; b = math.nan
        else:
            b = (n*sxy - sx*sy) / denom  # slope
            a = (sy - b*sx) / n
        # area at cfg capacity (if available)
        cfg = parse_cfg(base_cfg_path)
        cfg_MB = (cfg.get("capacity_B") / (1024*1024)) if cfg.get("capacity_B") else None
        area_at_cfg_MB = (a + b * cfg_MB) if (cfg_MB is not None and not math.isnan(a) and not math.isnan(b)) else math.nan
        return (b, area_at_cfg_MB)

    finally:
        try: shutil.rmtree(work)
        except Exception: pass

# ---------------------- main ----------------------

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("infile", nargs='*', help="NVSim CSV(s) to enrich. If omitted, use --run to generate one.")
    ap.add_argument("--cfg", default=None, help="NVSim .cfg for metadata and/or running NVSim")
    ap.add_argument("--run", action="store_true", help="Run NVSim once for the cfg capacity and enrich that CSV (single-command path).")
    ap.add_argument("--nvsim_bin", type=str, default="./nvsim")

    ap.add_argument("--banks", type=int, default=1)
    ap.add_argument("--nvm_headroom", type=float, default=0.9)
    ap.add_argument("--ecc_alpha", type=float, default=0.0)
    ap.add_argument("--ecc_area_frac", type=float, default=0.0)
    ap.add_argument("--ecc_energy_frac_logic", type=float, default=0.0)
    ap.add_argument("--ecc_on_link", action="store_true")
    ap.add_argument("--d2d_cap_GBs", type=float, default=1e9)
    ap.add_argument("--link_pj_per_bit", type=float, default=0.0)
    ap.add_argument("--retention_E_pJ_per_MB", type=float, default=0.0)
    ap.add_argument("--retention_T_s", type=float, default=1.0)
    ap.add_argument("--retention_temp_factor", type=float, default=1.0)
    ap.add_argument("--endurance_cycles", type=float, default=0.0)
    ap.add_argument("--endurance_write_factor", type=float, default=1.0)
    ap.add_argument("--endurance_time_factor", type=float, default=1.0)

    # sweep (optional)
    ap.add_argument("--sweep_min_MB", type=float, default=None)
    ap.add_argument("--sweep_max_MB", type=float, default=None)
    ap.add_argument("--sweep_step_MB", type=float, default=None)
    ap.add_argument("--keep_sweep_csv", action="store_true")
    args = ap.parse_args()

    cfg = parse_cfg(args.cfg) if args.cfg else {}
    line_bytes = (cfg.get("word_width_bits") // 8) if cfg.get("word_width_bits") else None
    process_nm = cfg.get("process_nm")
    tech = cfg.get("device")
    op_temp_C = (cfg.get("temp_K") - 273.15) if cfg.get("temp_K") is not None else None
    capacity_MB = (cfg.get("capacity_B") / (1024*1024)) if cfg.get("capacity_B") else None
    memcorner = cfg.get("memcell_file") or "NVM"

    # optional sweep & fit
    slope_mm2_per_MB = math.nan
    area_at_MB       = math.nan
    if (args.sweep_min_MB is not None and args.sweep_max_MB is not None and
        args.sweep_step_MB is not None and args.cfg):
        slope_mm2_per_MB, area_at_MB = sweep_and_fit_area(
            args.nvsim_bin, args.cfg, args.sweep_min_MB, args.sweep_max_MB, args.sweep_step_MB, keep_csv=args.keep_sweep_csv
        )

    cols = [
        "area_mm2","area_total_mm2",
        "read_lat_ns","write_lat_ns","read_E_pJ","write_E_pJ","leakage_mW","tRC_ns",
        "read_E_pJ_per_B_raw","write_E_pJ_per_B_raw",
        "read_E_pJ_per_payload_B","write_E_pJ_per_payload_B",
        "process_nm","tech","op_temp_C","line_bytes","banks","nvm_corner_id",
        "cap_effective_Bps","cap_effective_payload_Bps","e_link_pJ_per_B","P_retention_mW",
        "capacity_raw_MB","capacity_payload_MB",
        "Ew_endurance_scaled_pJ","tw_endurance_scaled_ns","endurance_cycles",
        "ecc_area_frac","ecc_energy_frac",
        "capacity_sweep_MB_min","capacity_sweep_MB_max","capacity_sweep_MB_step",
        "area_mm2_at_MB","area_slope_mm2_per_MB",
    ]
    print(",".join(cols))

    # If --run and no infile given: run NVSim once and add that file.
    infiles = []
    if args.infile:
        for pat in args.infile:
            infiles.extend(glob.glob(pat))
    if args.run and not infiles:
        if not args.cfg:
            print("ERROR: --run requires --cfg", file=sys.stderr); sys.exit(2)
        # ensure the current cfg has a stable OutputFilePrefix
        # run and capture actual CSV path from stdout
        csv_path = run_nvsim_and_get_csv(args.nvsim_bin, args.cfg, prefix_hint=None)
        if csv_path:
            infiles.append(csv_path)
        else:
            print("[nvsim_post] NVSim did not produce a CSV for --run", file=sys.stderr)

    if not infiles:
        # nothing to print beyond header
        return

    seen = set()
    for path in infiles:
        with open(path, 'r', encoding='utf-8') as f:
            for raw in f:
                raw = raw.strip()
                if not raw: continue
                if raw in seen:  # deduplicate identical NVSim rows
                    continue
                seen.add(raw)
                r = parse_nvsim_row(raw, expect_trailing_trc=True)
                if not r:
                    r = parse_nvsim_row(raw, expect_trailing_trc=False)
                if not r:
                    continue

                payload_ratio = 1.0 / (1.0 + args.ecc_alpha) if args.ecc_alpha > 0 else 1.0
                if not line_bytes or line_bytes <= 0:
                    read_pJ_per_B_raw = math.nan
                    write_pJ_per_B_raw = math.nan
                    read_pJ_per_payload_B = math.nan
                    write_pJ_per_payload_B = math.nan
                else:
                    read_pJ_per_B_raw  = r["read_E_pJ"]  / line_bytes
                    write_pJ_per_B_raw = r["write_E_pJ"] / line_bytes
                    logic_scale = (1.0 + args.ecc_energy_frac_logic)
                    ecc_expand  = (1.0 + args.ecc_alpha)
                    read_pJ_per_payload_B  = read_pJ_per_B_raw  * ecc_expand * logic_scale
                    write_pJ_per_payload_B = write_pJ_per_B_raw * ecc_expand * logic_scale

                e_link = 8.0 * args.link_pj_per_bit * (1.0 + (args.ecc_alpha if args.ecc_on_link else 0.0))

                if line_bytes and r["read_lat_ns"] and r["read_lat_ns"] > 0:
                    per_bank_Bps = line_bytes / (r["read_lat_ns"] * 1e-9)
                else:
                    per_bank_Bps = math.nan
                cap_nvm = args.nvm_headroom * args.banks * per_bank_Bps if not math.isnan(per_bank_Bps) else math.nan
                cap_d2d = args.d2d_cap_GBs * 1e9
                cap_d2d_payload = cap_d2d / (1.0 + args.ecc_alpha) if args.ecc_on_link else cap_d2d
                cap_effective = min(cap_nvm, cap_d2d) if (not math.isnan(cap_nvm)) else cap_d2d
                cap_effective_payload = min(cap_nvm, cap_d2d_payload) if (not math.isnan(cap_nvm)) else cap_d2d_payload

                if capacity_MB:
                    P_retention_W = (args.retention_E_pJ_per_MB * 1e-12 * capacity_MB / max(args.retention_T_s, 1e-30)) * args.retention_temp_factor
                    P_retention_mW = P_retention_W * 1e3
                else:
                    P_retention_mW = math.nan

                Ew_scaled = r["write_E_pJ"] * args.endurance_write_factor
                tw_scaled = r["write_lat_ns"] * args.endurance_time_factor

                area_total = r["area_mm2"] * (1.0 + args.ecc_area_frac)
                cap_raw_MB = capacity_MB if capacity_MB is not None else math.nan
                cap_pay_MB = (capacity_MB * payload_ratio) if capacity_MB is not None else math.nan

                corner_id = f"{(cfg.get('memcell_file') or 'NVM')}_{tech or 'TECH'}_{process_nm or 'PNM'}nm_{(int(op_temp_C) if op_temp_C is not None else 'TEMP')}C"

                row = [
                    f"{r['area_mm2']}", f"{area_total}",
                    f"{r['read_lat_ns']}",
                    f"{r['write_lat_ns']}",
                    f"{r['read_E_pJ']}",
                    f"{r['write_E_pJ']}",
                    f"{r['leakage_mW']}",
                    f"{r['tRC_ns']}",
                    f"{read_pJ_per_B_raw}",
                    f"{write_pJ_per_B_raw}",
                    f"{read_pJ_per_payload_B}",
                    f"{write_pJ_per_payload_B}",
                    f"{process_nm if process_nm is not None else ''}",
                    f"{tech if tech is not None else ''}",
                    f"{op_temp_C if op_temp_C is not None else ''}",
                    f"{line_bytes if line_bytes is not None else ''}",
                    f"{args.banks}",
                    corner_id,
                    f"{cap_effective}",
                    f"{cap_effective_payload}",
                    f"{e_link}",
                    f"{P_retention_mW}",
                    f"{cap_raw_MB}",
                    f"{cap_pay_MB}",
                    f"{Ew_scaled}",
                    f"{tw_scaled}",
                    f"{args.endurance_cycles}",
                    f"{args.ecc_area_frac}",
                    f"{args.ecc_energy_frac_logic}",
                    f"{args.sweep_min_MB if args.sweep_min_MB is not None else ''}",
                    f"{args.sweep_max_MB if args.sweep_max_MB is not None else ''}",
                    f"{args.sweep_step_MB if args.sweep_step_MB is not None else ''}",
                    f"{area_at_MB}",
                    f"{slope_mm2_per_MB}",
                ]
                print(",".join(row))

if __name__ == "__main__":
    main()
